{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "molq",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    // Replaces ghcr.io/molcrafts/features/{utils,miniforge}, neither of which
    // was ever published — this container could not build.
    "ghcr.io/molcrafts/devcontainers/molpy:1": {}
  },
  "postCreateCommand": "uv sync --extra dev && prek install",
  "remoteUser": "vscode"
}
